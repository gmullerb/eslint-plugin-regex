{
  "name": "eslint-plugin-regex",
  "description": "ESLint rules using Regular Expression",
  "version": "1.11.0",
  "license": "MIT",
  "author": "Gonzalo Müller Bravo",
  "main": "lib/index.js",
  "files": [
    "lib"
  ],
  "homepage": "https://eslint-plugin-regex.github.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/gmullerb/eslint-plugin-regex"
  },
  "bugs": {
    "url": "https://github.com/gmullerb/eslint-plugin-regex/issues"
  },
  "keywords": [
    "eslint-plugin-regex",
    "eslint",
    "regex-rule",
    "regex",
    "regexp",
    "eslint-regex",
    "eslint-rule",
    "eslint-regex-rule",
    "rule",
    "expression",
    "regular-expression",
    "eslint-regular-expression",
    "eslint-regular-expression-rule",
    "eslintrule",
    "regular-expression-rule",
    "eslintplugin",
    "eslint-plugin",
    "plugin",
    "coding style",
    "coding standards",
    "code checker",
    "code linter",
    "code quality",
    "code standards",
    "code style",
    "syntax",
    "lint",
    "linter",
    "jshint",
    "js-hint",
    "jslint",
    "js-lint",
    "js lint",
    "js quality",
    "js rules",
    "js rules",
    "js standards",
    "js style",
    "style guide",
    "style checker",
    "style linter",
    "standard",
    "standard style",
    "style"
  ],
  "scripts": {
    "$extends": "./scripts.js",
    "lint": "jko lint.common && jko lint.source",
    "lint.common": "jko -l=e title \"Lint Common\" && eslint --config eslint-any.config.mjs .",
    "$comment (lint.common)": "Runs general style checks",
    "lint.source": "jko -l=e title \"Lint Source Code\" && eslint --color .",
    "$comment (lint.source)": "Runs code style checks",
    "unit.test": "jko -l=e title \"Unit Tests\" -s && node --test \"tests/lib/**/*.test.js\"",
    "e2e.test": "jko -l=e title \"E2E Tests\" -s && node --test --test-reporter=spec \"tests/e2e/*.e2e-test.js\" \"tests/e2e/legacy/*.e2e-test.js\"",
    "test.only": "jko unit.test && jko e2e.test",
    "$comment (test.only)": "Runs tests without coverage",
    "test": "jko -l=e title \"Tests With Coverage\" && mkdir -p build && nyc jko test.only",
    "$comment (test)": "Runs tests with coverage",
    "check": "jko -l=e title \"Install\" && npm install && jko lint && jko test && mkdir -p build && cd build && npm pack ../",
    "$comment (check)": "Installs dependencies, runs code style checks, and creates a local package to verify the build before publishing",
    "$post (check)": "echo \"check OK\"",
    "check.all": "jko check && npm audit",
    "prepublishOnly": "jko get-publish-confirmation && jko check",
    "prepack": "jko title \"Build Package\"",
    "title": "echo ==== \"\\033[1;;33m\"$jko_arg_0\"\\033[0m\" ==== && echo"
  },
  "engines": {
    "node": ">=6.0.0"
  },
  "peerDependencies": {
    "eslint": ">=4.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "any-eslint-parser": "^1.0.1",
    "eslint": "^10.8.0",
    "eslint-legacy": "npm:eslint@^8.13.0",
    "eslint-plugin-base-style-config": "^2.9.2",
    "jko": "^1.0.0",
    "nyc": "^18.0.0"
  },
  "nyc": {
    "check-coverage": true,
    "branches": 85,
    "functions": 50,
    "statements": 25,
    "exclude": [
      "scripts.js",
      "tests/**"
    ],
    "reporter": [
      "lcov",
      "cobertura",
      "text",
      "text-summary"
    ],
    "report-dir": "build/coverage/report",
    "temp-dir": "build/coverage"
  },
  "funding": [
    {
      "type": "ko-fi",
      "url": "https://ko-fi.com/H2H21DLF1T"
    },
    {
      "type": "liberpay",
      "url": "https://liberapay.com/gmullerb/donate"
    }
  ]
}
